{
  "name": "obsidian-sample-plugin",
  "version": "0.0.0",
  "description": "This is a sample plugin for Obsidian (https://obsidian.md)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prebuild": "tsc --noEmit --skipLibCheck",
    "build": "node esbuild.config.mjs --production",
    "dev:prod": "node esbuild.config.mjs --vault",
    "dev": "node esbuild.config.mjs",
    "export": "node esbuild.config.mjs --production --vault",
    "bump": "dotenv -- node commit-and-tag-version.mjs",
    "postbump": "dotenv -- if-env SKIP_POST_BUMP=true && echo skip bump || git push --follow-tags origin master",
    "predeploy": "pnpm run bump",
    "deploy": "pnpm run export",
    "lint": "eslint .",
    "format": "biome format --write src/",
    "e2e": "pnpm run build && wdio run ./wdio.conf.mts"
  },
  "engines": {
    "node": "^26"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.0.0-beta.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "globals": "^17.6.0",
    "i18next": "^27.1.1",
    "jiti": "^2.6.1",
    "obsidian": "^1.8.7",
    "tslib": "2.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.1"
  },
  "dependencies": {
    "@delucis/if-env": "^1.1.2",
    "@types/bun": "^1.2.13",
    "@types/mocha": "^10.0.10",
    "@wdio/cli": "^10.2.0",
    "@wdio/globals": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "@wdio/spec-reporter": "^10.2.0",
    "ansi-colors": "^4.1.3",
    "commander": "^15.1.0",
    "commit-and-tag-version": "^13.3.0",
    "dedent": "^1.5.3",
    "dotenv": "^18.0.10",
    "dotenv-cli": "^11.1.0",
    "ejs": "^7.0.2",
    "execa": "^10.2.1",
    "git-user-name": "^2.0.0",
    "license": "^1.0.3",
    "obsidian-typings": "^6.59.0",
    "prompts": "^2.4.2",
    "spdx-license-list": "^6.10.0",
    "wdio-obsidian-reporter": "^3.5.0",
    "wdio-obsidian-service": "^3.5.0"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "electron",
    "esbuild",
    "obsidian-typings"
  ]
}
